{
  "name": "watcher",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension (MV3) that finds secrets exposed in your own web app's frontend. Local-only, read-only.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharvasail/watcher.git"
  },
  "bugs": {
    "url": "https://github.com/atharvasail/watcher/issues"
  },
  "homepage": "https://github.com/atharvasail/watcher#readme",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "serve": "node test-site/serve.mjs",
    "site": "node scripts/serve-site.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/rules.test.mjs tests/export.test.mjs tests/tooling.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "docs:rules": "node scripts/gen-rules-doc.mjs",
    "docs:rules:check": "node scripts/gen-rules-doc.mjs --check",
    "fp-baseline": "node scripts/fp-baseline.mjs node_modules",
    "build": "node scripts/build.mjs",
    "verify": "npm run lint && npm run format:check && npm run check:manifest && npm run check:contrast && npm run docs:rules:check && npm test && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.0.0",
    "playwright": "1.56.0",
    "prettier": "^3.6.0"
  }
}
